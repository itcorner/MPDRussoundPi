[Unit]
Description=MPDRussoundPi updater: web-triggered image and Pi system updates through the reviewed tooling
After=docker.service network-online.target
# Wants, not Requires: a Docker upgrade during a Pi system update stops Docker,
# and the updater must keep watching that installation instead of being stopped.
Wants=docker.service network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mpdrussoundpi-deploy
ExecStart=/opt/mpdrussoundpi-deploy/.venv/bin/python -m tool.deployment_updater serve
Restart=on-failure
RestartSec=5
# Stopping the service ends a pending review; an approved operation keeps its
# durable record and is reported as outcome unknown after a restart.
TimeoutStopSec=30
KillMode=control-group
UMask=0077
# The public update status (tool/deployment_updater.PUBLIC_STATUS), read by the HTTPS proxy
# while the web application restarts. Removed when the updater stops.
RuntimeDirectory=mpdrussoundpi-updater-public
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
