# Managed by Ansible (deploy-russound-docker.yml). Local edits will be overwritten.
# Consumed by docker-compose.yml in this directory.

# Published web port on the host.
RUSSOUND_PUBLISH_PORT={{ russound_publish_port }}

# USB serial device passed into the container and used by ser2net.
RUSSOUND_SERIAL_DEVICE={{ russound_serial_device }}
RUSSOUND_SERIAL_OPTIONS={{ russound_serial_options }}
RUSSOUND_SER2NET_ENABLED={{ russound_ser2net_enabled | lower }}
RUSSOUND_SER2NET_PORT={{ russound_ser2net_port }}

# Group owning the serial device on this host.
RUSSOUND_SERIAL_GID={{ russound_serial_gid }}

# Endpoint the web application talks to.
RUSSOUND_BACKEND_HOST={{ russound_backend_host }}
RUSSOUND_BACKEND_PORT={{ russound_backend_port }}

# Ownership for the bind-mounted config and state directories.
RUSSOUND_UID={{ russound_uid }}
RUSSOUND_GID={{ russound_gid }}

RUSSOUND_DEBUG={{ russound_debug | lower }}
