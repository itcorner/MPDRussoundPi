# Managed by ansible/playbooks/deploy-web-tls.yml; see docs/plans/general_done_web-ui-https.md.
{
	admin 127.0.0.1:{{ web_tls_admin_port }}
	auto_https off
	# Event streams stay open indefinitely; without a limit a restart waits for them (up to the
	# unit's stop timeout) with the listener already closed. Pages reconnect on their own.
	grace_period 2s
	# Clients that send no SNI (addressing the Pi by IP) still get the server certificate.
	default_sni {{ web_tls_dns_names[0] }}
	servers {
		protocols h1 h2
	}
}

https://:{{ web_tls_https_port }} {
	tls {{ web_tls_dir }}/server.crt {{ web_tls_dir }}/server.key
	# The trust page on HTTPS too: browsers upgrade http:// links to https:// on their own.
	redir /ca /ca/ 308
	handle_path /ca/* {
		root * {{ web_tls_dir }}/public
		file_server
	}
	# The updater's public status: the Status page reads it while the web application restarts
	# during an update (tool/deployment_updater.PUBLIC_STATUS). Only this one file, never cached.
	handle /update-status.json {
		root * {{ web_tls_updater_public_dir }}
		header Cache-Control "no-store"
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:{{ web_tls_upstream_port }} {
			# /api/events is a server-sent event stream: never buffer it.
			flush_interval -1
		}
	}
}

http://:{{ web_tls_http_port }} {
	redir /ca /ca/ 308
	handle_path /ca/* {
		root * {{ web_tls_dir }}/public
		file_server
	}
	handle {
		redir https://{host}{% if web_tls_https_port != 443 %}:{{ web_tls_https_port }}{% endif %}{uri} 308
	}
}
