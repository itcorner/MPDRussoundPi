{
	admin 127.0.0.1:2020
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

https://{{ playback_proxy_hostname }}:{{ playback_proxy_port }} {
	tls {{ playback_proxy_certificate }} {{ playback_proxy_private_key }}

	@docker_host remote_ip {{ playback_proxy_allowed_cidr }}
	handle @docker_host {
		@read_api {
			path /v1/health /v1/capabilities /v1/outputs /v1/outputs/* /v1/favorites
			method GET HEAD
		}
		handle @read_api {
			reverse_proxy 127.0.0.1:{{ playback_agent_port }}
		}
{% if playback_proxy_enable_operations | default(false) %}
		@write_api {
			path /v1/outputs/*/operations /v1/favorites/operations
			method POST
		}
		handle @write_api {
			reverse_proxy 127.0.0.1:{{ playback_agent_port }}
		}
		@operations_api {
			path /v1/operations/*
			method GET HEAD
		}
		handle @operations_api {
			reverse_proxy 127.0.0.1:{{ playback_agent_port }}
		}
{% endif %}
		respond 404
	}

	respond 403
}
