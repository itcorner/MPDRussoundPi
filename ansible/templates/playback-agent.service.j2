[Unit]
Description=Read-only MPD playback observation agent
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory={{ playback_agent_dir }}
ExecStart={{ playback_agent_venv }}/bin/python {{ playback_agent_dir }}/playbackagent.py {{ playback_agent_config }} --agent-id {{ playback_agent_id }} --token-file {{ playback_agent_secret_dir }}/token --host 127.0.0.1 --port {{ playback_agent_port }}
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_RUNTIME_DIR=/run/user/{{ ansible_facts['user_uid'] }}
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{ ansible_facts['user_uid'] }}/bus
Environment=PULSE_SERVER=unix:/run/user/{{ ansible_facts['user_uid'] }}/pulse/native
UMask=0077
NoNewPrivileges=true
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=control-group

[Install]
WantedBy=default.target
