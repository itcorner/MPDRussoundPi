.git/
.github/
.venv/
.vscode/
**/__pycache__/
**/*.pyc

ansible/
docs/
# Only the shared package the web image copies. Re-including a directory
# brings back everything below it, so list exactly what the image needs.
mpdrussoundpi/**
!mpdrussoundpi/__init__.py
!mpdrussoundpi/common/
tests/
tool/

# Runtime mount points.
docker/

# Documentation is not served by the app; keeping it out of the image also means a
# docs-only change publishes nothing (tool/ci/image-changes.mjs ignores it too).
**/*.md

# Never bake local runtime data or secrets into the image.
web/russound_config.json
web/russound_state.json
**/*.log

docker-compose.yml
Dockerfile
.dockerignore
.env
