.git/
.github/
.venv/
.vscode/
**/__pycache__/
**/*.pyc

ansible/
docs/
# Only the shared modules the web image copies. Re-including a directory
# (e.g. !mpdrussoundpi/russound/) would bring back everything below it.
mpdrussoundpi/**
!mpdrussoundpi/__init__.py
!mpdrussoundpi/russound/__init__.py
!mpdrussoundpi/russound/lib/__init__.py
!mpdrussoundpi/russound/lib/sourceurl.py
!mpdrussoundpi/russound/lib/publicnetwork.py
!mpdrussoundpi/russound/lib/tunein.py
!mpdrussoundpi/russound/lib/servicecredentials.py
!mpdrussoundpi/russound/lib/runtimelogging.py
tests/
tool/

# Runtime mount points.
docker/

# Never bake local runtime data or secrets into the image.
web/russound_config.json
web/russound_state.json
**/*.log

docker-compose.yml
Dockerfile
.dockerignore
.env
